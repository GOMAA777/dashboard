# Static export for https://law.almonrj.com/dashboard/
# Upload the CONTENTS of the "out" folder into public_html/dashboard/
# The "_next" folder must sit next to "login" and "index.html".

Options -MultiViews -Indexes
DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddType image/svg+xml .svg
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/webp .webp
  AddType image/gif .gif
  AddType image/x-icon .ico
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /dashboard/

  # Never rewrite Next.js assets. If these are rewritten to HTML,
  # the browser shows the page with no design and no interaction.
  RewriteRule ^_next/ - [L]
  RewriteRule ^__next - [L]
  RewriteRule \.(?:css|js|mjs|map|json|txt|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|eot|xml|webmanifest)$ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /dashboard/login -> /dashboard/login/index.html
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # /dashboard/login.html style exports
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

ErrorDocument 404 /dashboard/404.html
