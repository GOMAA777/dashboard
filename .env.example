# Server-only environment variables (Do NOT expose to client)
API_BASE_URL=https://law.elmoroj.com/api
API_SECRET_KEY=

# Public environment variables (Client-accessible)
# Required for static export / cPanel builds — browser calls the API directly.
NEXT_PUBLIC_API_BASE_URL=https://law.elmoroj.com/api
NEXT_PUBLIC_API_COMPANY_ID=2
NEXT_PUBLIC_APP_URL=https://law.elmoroj.com/dashboard

NEXT_PUBLIC_LAWYER_APP_URL=https://law.elmoroj.com/lawyer
NEXT_PUBLIC_SUPER_ADMIN_APP_URL=https://law.elmoroj.com/dashboard

# Temporary unlock — set to false when real admin login must be enforced
NEXT_PUBLIC_AUTH_BYPASS=false
